{
    "name": "slm/queue-sqs",
    "description": "Laminas module that integrates with Amazon SQS queuing system",
    "license": "BSD-3-Clause",
    "type": "library",
    "keywords": [
        "laminas",
        "queue",
        "job",
        "amazon aws",
        "sqs"
    ],
    "homepage": "https://github.com/Webador/SlmQueueSqs",
    "authors": [
        {
            "name": "Jurian Sluiman",
            "email": "jurian@juriansluiman.nl",
            "homepage": "http://juriansluiman.nl"
        },
        {
            "name": "Michaël Gallego",
            "email": "mic.gallego@gmail.com",
            "homepage": "http://www.michaelgallego.fr"
        }
    ],
    "require": {
        "ext-json": "*",
        "php": "^8.2",
        "laminas/laminas-eventmanager": "^3.14",
        "laminas/laminas-servicemanager": "^3.24 | ^4.5",
        "laminas/laminas-stdlib": "^3.21",
        "laminas/laminas-cli": "^1.13",
        "slm/queue": "^4",
        "aws/aws-sdk-php": "^3.356"
    },
    "require-dev": {
      "laminas/laminas-modulemanager": "^2.19",
      "phpunit/phpunit": "^10.5.58",
      "squizlabs/php_codesniffer": "^3.6.2",
      "vimeo/psalm": "^6.13"
    },
    "extra": {
        "branch-alias": {
            "dev-master": "1.1.x-dev"
        },
        "zf": {
            "module": "SlmQueueSqs\\Module"
        }
    },
    "autoload": {
        "psr-4": {
            "SlmQueueSqs\\": "src/"
        },
        "classmap": [
            "./Module.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "SlmQueueSqsTest\\": "tests/"
        }
    },
    "scripts": {
        "cs-check": "phpcs",
        "cs-fix": "phpcbf"
    },
    "repositories": [
      {
        "type": "git",
        "url": "git@github.com:datasage/SlmQueue.git"
      }
    ]
}
